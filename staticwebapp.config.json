{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/fuente/*",
      "statusCode": 404
    },
    {
      "route": "/README.md",
      "statusCode": 404
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Robots-Tag": "noindex, nofollow"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
